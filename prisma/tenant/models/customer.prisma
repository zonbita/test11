model Customer {
  id               String         @id @default(uuid()) @db.Uuid
  companyId        String         @map("company_id") @db.Uuid
  // Auto-assigned (C00001...), unique per company, never editable (F06 BR-02)
  code             String
  type             CustomerType
  status           CustomerStatus @default(ACTIVE)
  name             String
  firstName        String?        @map("first_name")
  lastName         String?        @map("last_name")
  legalForm        String?        @map("legal_form")
  siret            String?
  vatNumber        String?        @map("vat_number")
  email            String?
  phone            String?
  website          String?
  paymentTermsDays Int?           @map("payment_terms_days")
  paymentMethod    PaymentMethod? @map("payment_method")
  defaultTaxRateId String?        @map("default_tax_rate_id") @db.Uuid
  tags             String[]       @default([])
  notes            String?
  ownerId          String         @map("owner_id") @db.Uuid
  createdById      String?        @map("created_by") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  // Trash for customers without documents; customers with documents are ARCHIVED instead
  deletedAt        DateTime?      @map("deleted_at")

  company        Company           @relation(fields: [companyId], references: [id])
  owner          User              @relation("CustomerOwner", fields: [ownerId], references: [id])
  defaultTaxRate TaxRate?          @relation(fields: [defaultTaxRateId], references: [id])
  contacts       CustomerContact[]
  addresses      CustomerAddress[]
  shares         CustomerShare[]
  quotes         Quote[]
  invoices       Invoice[]
  creditNotes    CreditNote[]

  @@unique([companyId, code])
  @@index([companyId, ownerId])
  @@index([companyId, name])
  @@index([companyId, siret])
  @@map("customers")
}
