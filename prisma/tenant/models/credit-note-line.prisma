model CreditNoteLine {
  id           String   @id @default(uuid()) @db.Uuid
  creditNoteId String   @map("credit_note_id") @db.Uuid
  position     Int
  type         LineType @default(ITEM)
  label        String?
  description  String?
  quantity     Decimal? @db.Decimal(12, 3)
  unitPrice    Decimal? @map("unit_price") @db.Decimal(14, 4)
  vatRate      Decimal? @map("vat_rate") @db.Decimal(5, 2)
  totalHt      Decimal? @map("total_ht") @db.Decimal(14, 2)

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@index([creditNoteId, position])
  @@map("credit_note_lines")
}
