NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Human-readable logs (dev only)
LOG_PRETTY=true
# Number of reverse-proxy hops in front of the API (for client IPs / rate limiting)
TRUST_PROXY=0

# Base domain: tenant "dfm" is served at dfm.<APP_BASE_DOMAIN>
APP_BASE_DOMAIN=localhost
# Extra CORS origins, comma separated (*.APP_BASE_DOMAIN is always allowed)
CORS_ORIGINS=

# Control plane DB (tenants, plans, platform admins)
CONTROL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compte_control

# Superuser connection used ONLY to create/drop tenant databases and roles
TENANT_DB_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432

# Used by `prisma migrate dev` for the tenant schema (a dev/template tenant DB)
TENANT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compte_tenant_dev

# 32-byte key, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
DB_CREDENTIALS_KEY=change-me-base64-32-bytes

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Requests per minute per IP (all routes / login routes)
THROTTLE_DEFAULT_LIMIT=120
THROTTLE_LOGIN_LIMIT=10

# Bootstrap super admin (scripts/seed-control.ts)
PLATFORM_ADMIN_EMAIL=admin@platform.local
PLATFORM_ADMIN_PASSWORD=ChangeMe-Platform-2026
